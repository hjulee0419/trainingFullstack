{
  "openapi": "3.0.3",
  "info": {
    "title": "TodoList API",
    "version": "1.0.0",
    "description": "인증된 사용자가 개인별로 할일(Todo)을 카테고리로 분류하고, 시작일자/종료일자 기반 상태(시작 전/진행중/완료/기한초과)를 자동 추적할 수 있는 TodoList 서비스의 REST API. JWT 기반 stateless 인증을 사용하며, 모든 할일/카테고리 리소스는 소유자 기반 접근 제어를 적용한다(타인 소유 리소스 접근 시 403이 아닌 404 응답). 참조: docs/1-domain-definition.md, docs/2-PRD.md(FR-1~FR-13), docs/4-project-structure.md, docs/6-erd.md, docs/8-wireframe.md."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "로컬 개발 서버"
    },
    {
      "url": "https://api.todolist.example.com",
      "description": "운영 서버 (placeholder)"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "회원가입/로그인 (FR-1, FR-2)" },
    { "name": "Users", "description": "계정 정보 조회/수정 (FR-3)" },
    { "name": "Categories", "description": "카테고리 관리 (FR-8, FR-9)" },
    { "name": "Todos", "description": "할일 관리 (FR-4, FR-5, FR-6, FR-7)" }
  ],
  "paths": {
    "/api/v1/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "회원가입",
        "description": "이메일, 비밀번호, 닉네임으로 신규 계정을 생성한다. (FR-1, UC-1) 이메일은 시스템 내 유일해야 하며, 비밀번호는 bcrypt 등으로 해시 저장된다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SignupRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "회원가입 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": {
            "description": "필수 입력값 누락 또는 이메일 형식 오류",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "statusCode": 400, "message": "이메일 형식이 올바르지 않습니다." }
              }
            }
          },
          "409": {
            "description": "이미 가입된 이메일 (이메일 중복)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "statusCode": 409, "message": "이미 사용 중인 이메일입니다." }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "로그인",
        "description": "이메일과 비밀번호로 인증하고, 성공 시 JWT 액세스 토큰을 발급한다. (FR-2, UC-2) 인증 실패 시 계정 존재 여부를 노출하지 않는 일반화된 메시지를 반환한다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공, JWT 토큰 반환",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "400": {
            "description": "필수 입력값 누락",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "이메일 또는 비밀번호 불일치",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "statusCode": 401, "message": "이메일 또는 비밀번호가 올바르지 않습니다." }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "내 정보 조회",
        "description": "로그인한 사용자 본인의 이메일, 닉네임, 가입일시를 조회한다. (FR-3, UC-3, 8-wireframe S6)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "내 정보 조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "내 정보 수정 (닉네임/비밀번호)",
        "description": "로그인한 사용자 본인의 닉네임과 비밀번호를 수정한다. 비밀번호는 선택 입력이며 입력 시에만 변경된다. (FR-3, UC-3, 8-wireframe S7) 신규 비밀번호는 최소 길이 등 기본 정책을 따른다.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateUserRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "계정 정보 수정 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": {
            "description": "비밀번호 최소 길이 등 유효성 오류",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "statusCode": 400, "message": "비밀번호는 최소 8자 이상이어야 합니다." }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories": {
      "get": {
        "tags": ["Categories"],
        "summary": "카테고리 목록 조회",
        "description": "로그인한 사용자가 소유한 카테고리 목록을 조회한다. '기본' 카테고리를 포함한다. (FR-8, FR-9, UC-8, UC-9)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "카테고리 목록 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Category" }
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Categories"],
        "summary": "카테고리 생성",
        "description": "이름을 지정해 새 카테고리를 생성한다. 동일 사용자 내 이름 중복은 허용하지 않는다. (FR-8, UC-8)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateCategoryRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "카테고리 생성 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Category" }
              }
            }
          },
          "400": {
            "description": "카테고리 이름 누락 등 유효성 오류",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "동일 사용자 내 동일 이름 카테고리가 이미 존재함",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "statusCode": 409, "message": "이미 존재하는 카테고리 이름입니다." }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories/{categoryId}": {
      "patch": {
        "tags": ["Categories"],
        "summary": "카테고리 수정",
        "description": "소유자 본인의 카테고리 이름을 수정한다. '기본' 카테고리는 수정할 수 없다. (FR-9, UC-9) 본인 소유가 아닌 카테고리에 대한 요청은 404로 처리한다(도메인 규칙 4, FR-10).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CategoryId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateCategoryRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "카테고리 수정 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Category" }
              }
            }
          },
          "400": {
            "description": "카테고리 이름 유효성 오류 또는 '기본' 카테고리 수정 시도",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "statusCode": 400, "message": "'기본' 카테고리는 수정할 수 없습니다." }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "존재하지 않거나 본인 소유가 아닌 카테고리",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "statusCode": 404, "message": "카테고리를 찾을 수 없습니다." }
              }
            }
          },
          "409": {
            "description": "동일 사용자 내 동일 이름 카테고리가 이미 존재함",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Categories"],
        "summary": "카테고리 삭제",
        "description": "소유자 본인의 카테고리를 삭제한다. 삭제 시 해당 카테고리에 속한 할일은 삭제되지 않고 모두 '기본' 카테고리로 자동 이관된다(트랜잭션 처리). '기본' 카테고리는 삭제할 수 없다. (FR-9, UC-9, 도메인 규칙 7) 본인 소유가 아닌 카테고리에 대한 요청은 404로 처리한다.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CategoryId" }
        ],
        "responses": {
          "204": {
            "description": "카테고리 삭제 성공 (소속 할일은 '기본' 카테고리로 자동 이관됨)"
          },
          "400": {
            "description": "'기본' 카테고리는 삭제할 수 없음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "statusCode": 400, "message": "'기본' 카테고리는 삭제할 수 없습니다." }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "존재하지 않거나 본인 소유가 아닌 카테고리",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/todos": {
      "get": {
        "tags": ["Todos"],
        "summary": "할일 목록 조회",
        "description": "로그인한 사용자가 소유한 할일 목록을 페이지네이션과 함께 조회한다. 카테고리 필터(categoryId)와 상태 필터(status)를 AND 조건으로 동시 적용할 수 있다. 각 할일 응답에는 완료 여부/시작일자/종료일자를 기준으로 조회 시점에 계산된 파생 status가 포함된다. (FR-5, UC-5)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "categoryId",
            "in": "query",
            "description": "카테고리 ID로 필터링",
            "required": false,
            "schema": { "type": "integer", "format": "int64" }
          },
          {
            "name": "status",
            "in": "query",
            "description": "파생 상태로 필터링",
            "required": false,
            "schema": { "$ref": "#/components/schemas/TodoStatus" }
          },
          {
            "name": "page",
            "in": "query",
            "description": "페이지 번호 (1부터 시작, 기본값 1)",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "페이지당 항목 수 (기본값 20)",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "할일 목록 조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TodoListResponse" }
              }
            }
          },
          "400": {
            "description": "잘못된 쿼리 파라미터 (예: 허용되지 않는 status 값)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Todos"],
        "summary": "할일 등록",
        "description": "제목(필수), 설명(선택), 카테고리(선택, 미지정 시 '기본' 자동 적용), 시작일자/종료일자(필수)를 입력받아 할일을 생성한다. 종료일자는 시작일자보다 이전일 수 없다(같은 날짜 허용). (FR-4, UC-4)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTodoRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "할일 등록 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Todo" }
              }
            }
          },
          "400": {
            "description": "필수값 누락 또는 종료일자가 시작일자보다 이전인 경우",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "statusCode": 400, "message": "종료일자는 시작일자 이후여야 합니다." }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "지정한 categoryId가 존재하지 않거나 본인 소유가 아님",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/todos/{todoId}": {
      "get": {
        "tags": ["Todos"],
        "summary": "할일 상세 조회",
        "description": "소유자 본인의 할일 상세 정보를 조회한다. 파생 status가 포함된다. 본인 소유가 아닌 할일에 대한 요청은 404로 처리한다.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TodoId" }
        ],
        "responses": {
          "200": {
            "description": "할일 상세 조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Todo" }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "존재하지 않거나 본인 소유가 아닌 할일",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Todos"],
        "summary": "할일 수정",
        "description": "소유자는 제목, 설명, 카테고리, 시작일자, 종료일자, 완료 여부를 수정할 수 있다. 완료 여부를 '완료'로 변경할 때는 완료일시가 자동 기록된다(FR-11). 수정 시에도 종료일자 ≥ 시작일자 규칙이 동일하게 적용된다. (FR-6, UC-6) 본인 소유가 아닌 할일에 대한 요청은 404로 처리한다.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TodoId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTodoRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "할일 수정 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Todo" }
              }
            }
          },
          "400": {
            "description": "종료일자가 시작일자보다 이전인 경우 등 유효성 오류",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "statusCode": 400, "message": "종료일자는 시작일자 이후여야 합니다." }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "존재하지 않거나 본인 소유가 아닌 할일(또는 지정한 categoryId가 본인 소유가 아님)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Todos"],
        "summary": "할일 삭제",
        "description": "소유자는 자신의 할일을 삭제할 수 있다. (FR-7, UC-7) 본인 소유가 아닌 할일에 대한 요청은 404로 처리한다.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TodoId" }
        ],
        "responses": {
          "204": {
            "description": "할일 삭제 성공"
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "존재하지 않거나 본인 소유가 아닌 할일",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "로그인 성공 시 발급되는 JWT를 `Authorization: Bearer <token>` 헤더로 전달한다. stateless 인증이며 서버 측 세션/블랙리스트를 두지 않는다(FR-2)."
      }
    },
    "parameters": {
      "TodoId": {
        "name": "todoId",
        "in": "path",
        "required": true,
        "description": "할일 ID",
        "schema": { "type": "integer", "format": "int64" }
      },
      "CategoryId": {
        "name": "categoryId",
        "in": "path",
        "required": true,
        "description": "카테고리 ID",
        "schema": { "type": "integer", "format": "int64" }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "description": "공통 에러 응답 포맷 (4-project-structure.md 6.2 참조)",
        "properties": {
          "statusCode": { "type": "integer", "example": 400 },
          "message": { "type": "string", "example": "요청 값이 올바르지 않습니다." }
        },
        "required": ["statusCode", "message"]
      },
      "PaginationMeta": {
        "type": "object",
        "description": "목록 조회 페이지네이션 메타 정보",
        "properties": {
          "page": { "type": "integer", "example": 1 },
          "limit": { "type": "integer", "example": 20 },
          "totalCount": { "type": "integer", "example": 42 },
          "totalPages": { "type": "integer", "example": 3 }
        },
        "required": ["page", "limit", "totalCount", "totalPages"]
      },
      "TodoStatus": {
        "type": "string",
        "description": "할일의 파생 상태. DB 저장 컬럼이 아니라 is_completed/startDate/endDate를 기준으로 조회 시점에 계산된다(도메인 정의서 4장).",
        "enum": ["not_started", "in_progress", "completed", "overdue"],
        "example": "in_progress"
      },
      "User": {
        "type": "object",
        "description": "사용자 계정 정보 응답",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1 },
          "email": { "type": "string", "format": "email", "example": "user@mail.com" },
          "nickname": { "type": "string", "example": "홍길동" },
          "createdAt": { "type": "string", "format": "date-time", "example": "2026-05-01T09:12:00Z" }
        },
        "required": ["id", "email", "nickname", "createdAt"]
      },
      "SignupRequest": {
        "type": "object",
        "description": "회원가입 요청 (FR-1)",
        "properties": {
          "email": { "type": "string", "format": "email", "example": "user@mail.com" },
          "password": { "type": "string", "format": "password", "minLength": 8, "example": "P@ssw0rd123" },
          "nickname": { "type": "string", "example": "홍길동" }
        },
        "required": ["email", "password", "nickname"]
      },
      "LoginRequest": {
        "type": "object",
        "description": "로그인 요청 (FR-2)",
        "properties": {
          "email": { "type": "string", "format": "email", "example": "user@mail.com" },
          "password": { "type": "string", "format": "password", "example": "P@ssw0rd123" }
        },
        "required": ["email", "password"]
      },
      "LoginResponse": {
        "type": "object",
        "description": "로그인 성공 응답 (JWT 액세스 토큰 포함)",
        "properties": {
          "accessToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
          "tokenType": { "type": "string", "example": "Bearer" },
          "expiresIn": { "type": "integer", "description": "초 단위 만료 시간(예: 3600 = 1시간)", "example": 3600 },
          "user": { "$ref": "#/components/schemas/User" }
        },
        "required": ["accessToken", "tokenType", "user"]
      },
      "UpdateUserRequest": {
        "type": "object",
        "description": "계정 정보 수정 요청. 닉네임은 항상 수정 가능하며, 비밀번호는 입력 시에만 변경 처리된다. (FR-3)",
        "properties": {
          "nickname": { "type": "string", "example": "새닉네임" },
          "password": { "type": "string", "format": "password", "minLength": 8, "description": "신규 비밀번호(선택). 입력 시 최소 8자 이상 정책이 적용된다.", "example": "NewP@ss123" }
        }
      },
      "Category": {
        "type": "object",
        "description": "카테고리 응답",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 10 },
          "name": { "type": "string", "example": "과제" },
          "isDefault": { "type": "boolean", "description": "'기본' 카테고리 여부. true인 카테고리는 수정/삭제할 수 없다.", "example": false },
          "ownerId": { "type": "integer", "format": "int64", "example": 1 },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "isDefault", "ownerId", "createdAt", "updatedAt"]
      },
      "CreateCategoryRequest": {
        "type": "object",
        "description": "카테고리 생성 요청 (FR-8)",
        "properties": {
          "name": { "type": "string", "minLength": 1, "example": "스터디" }
        },
        "required": ["name"]
      },
      "UpdateCategoryRequest": {
        "type": "object",
        "description": "카테고리 수정 요청 (FR-9)",
        "properties": {
          "name": { "type": "string", "minLength": 1, "example": "마케팅 캠페인" }
        },
        "required": ["name"]
      },
      "Todo": {
        "type": "object",
        "description": "할일 응답. status는 저장값이 아니라 completed/startDate/endDate를 기준으로 응답 시점에 계산되는 파생 필드다(도메인 정의서 4장).",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 100 },
          "title": { "type": "string", "example": "데이터베이스 프로젝트 보고서" },
          "description": { "type": "string", "nullable": true, "example": "3장 분량, 참고문헌 포함" },
          "categoryId": { "type": "integer", "format": "int64", "example": 10 },
          "categoryName": { "type": "string", "example": "과제" },
          "startDate": { "type": "string", "format": "date", "example": "2026-07-25" },
          "endDate": { "type": "string", "format": "date", "example": "2026-08-05" },
          "isCompleted": { "type": "boolean", "example": false },
          "completedAt": { "type": "string", "format": "date-time", "nullable": true, "example": null },
          "status": { "$ref": "#/components/schemas/TodoStatus" },
          "ownerId": { "type": "integer", "format": "int64", "example": 1 },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "title", "categoryId", "startDate", "endDate", "isCompleted", "status", "ownerId", "createdAt", "updatedAt"]
      },
      "CreateTodoRequest": {
        "type": "object",
        "description": "할일 등록 요청. categoryId를 지정하지 않으면 '기본' 카테고리가 자동 적용된다. endDate는 startDate보다 이전일 수 없다(같은 날짜 허용). (FR-4)",
        "properties": {
          "title": { "type": "string", "minLength": 1, "example": "데이터베이스 프로젝트 보고서" },
          "description": { "type": "string", "nullable": true, "example": "3장 분량, 참고문헌 포함" },
          "categoryId": { "type": "integer", "format": "int64", "nullable": true, "description": "미지정 시 '기본' 카테고리 자동 적용", "example": 10 },
          "startDate": { "type": "string", "format": "date", "example": "2026-07-25" },
          "endDate": { "type": "string", "format": "date", "example": "2026-08-05" }
        },
        "required": ["title", "startDate", "endDate"]
      },
      "UpdateTodoRequest": {
        "type": "object",
        "description": "할일 수정 요청. 제공된 필드만 부분 수정된다. isCompleted를 true로 변경하면 completedAt이 서버에서 자동 기록된다(FR-11). (FR-6)",
        "properties": {
          "title": { "type": "string", "minLength": 1, "example": "데이터베이스 프로젝트 최종 보고서" },
          "description": { "type": "string", "nullable": true, "example": "4장 분량으로 보완" },
          "categoryId": { "type": "integer", "format": "int64", "example": 11 },
          "startDate": { "type": "string", "format": "date", "example": "2026-07-26" },
          "endDate": { "type": "string", "format": "date", "example": "2026-08-06" },
          "isCompleted": { "type": "boolean", "example": true }
        }
      },
      "TodoListResponse": {
        "type": "object",
        "description": "할일 목록 조회 응답 (파생 status 포함 + 페이지네이션 메타)",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Todo" }
          },
          "pagination": { "$ref": "#/components/schemas/PaginationMeta" }
        },
        "required": ["items", "pagination"]
      }
    }
  }
}
